<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidebarModalOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:elevation="32dp"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/background_popup"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/sidebarModalImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/Source_Code"
            android:scaleType="fitCenter"
            android:src="@drawable/popup_status"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sidebarModalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/museo_bold"
            android:textColor="@color/textColorPrimary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/sidebarModalMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat"
            android:lineSpacingExtra="3dp"
            android:maxHeight="280dp"
            android:scrollbars="vertical"
            android:textIsSelectable="true"
            android:textColor="@color/colorGrayText"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/sidebarLanguageOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/sidebarLanguageEnglish"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/language_english"
                android:textColor="@color/textColorPrimary" />

            <RadioButton
                android:id="@+id/sidebarLanguageHindi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/language_hindi"
                android:textColor="@color/textColorPrimary" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sidebarModalCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="@android:string/cancel"
                android:textColor="@color/textColorPrimary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sidebarModalAction"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_accent_button"
                android:minWidth="120dp"
                android:textColor="@color/keyAccentText" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
