<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_body"
    tools:context=".SplashActivity">

    <!-- Device hero -->
    <LinearLayout
        android:id="@+id/splashHero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <!-- LCD display panel, styled exactly like the calculator screen -->
        <FrameLayout
            android:id="@+id/splashDisplay"
            android:layout_width="272dp"
            android:layout_height="146dp"
            android:background="@drawable/bg_display_panel"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Status strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/DisplayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calculator_model" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/DisplayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="@string/degrees_abbreviation" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="11dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_solar_cell" />
                </LinearLayout>

                <!-- App icon + name, seated inside the glass like a boot screen -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/appName"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/museo_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:shadowColor="@color/displayGlow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="14"
                        android:text="@string/appName"
                        android:textColor="@color/displayNonMockFontColor"
                        android:textSize="24sp" />
                </LinearLayout>

                <!-- Digital version readout -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/DisplayText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleY="1.0"
                        android:text="@string/calculatorDisplayMock"
                        android:textColor="@color/displayMockFontColor"
                        android:textSize="20sp" />

                    <TextView
                        style="@style/DisplayText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleY="1.0"
                        android:shadowColor="@color/displayGlow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        android:text="@string/splashLcdVersion"
                        android:textColor="@color/displayNonMockFontColor"
                        android:textSize="20sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- App name -->
        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/museo_bold"
            android:includeFontPadding="false"
            android:text="@string/appName"
            android:textColor="@color/textColorPrimary"
            android:textSize="34sp" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat"
            android:letterSpacing="0.12"
            android:text="@string/appTagline"
            android:textAllCaps="true"
            android:textColor="@color/colorGrayText"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Footer / loader -->
    <LinearLayout
        android:id="@+id/splashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="128dp"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/colorAccent"
            android:indeterminateTintMode="src_in" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/montserrat"
            android:letterSpacing="0.14"
            android:text="@string/splashBooting"
            android:textAllCaps="true"
            android:textColor="@color/colorGrayText"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
