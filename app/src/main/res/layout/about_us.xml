<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_body"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".AboutUs">

    <!-- ============================ Top bar ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/textColorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/museo_bold"
            android:letterSpacing="0.01"
            android:text="@string/About"
            android:textColor="@color/textColorPrimary"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <!-- ============================ Hero ============================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="26dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/nav_icon_ring">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/appName"
                        android:src="@mipmap/ic_launcher" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/museo_bold"
                    android:text="@string/appName"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/montserrat"
                    android:text="@string/appTagline"
                    android:textColor="@color/colorGrayText"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_version_chip"
                    android:fontFamily="@font/montserrat"
                    android:paddingStart="14dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="5dp"
                    android:text="@string/appVersion"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============================ Description ============================ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:fontFamily="@font/montserrat"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:text="@string/appDescription"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp" />

            <!-- ============================ Section header ============================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/museo_bold"
                android:letterSpacing="0.12"
                android:text="@string/about_connect"
                android:textAllCaps="true"
                android:textColor="@color/colorAccent"
                android:textSize="12sp" />

            <!-- Email -->
            <LinearLayout
                android:id="@+id/rowEmail"
                style="@style/AboutRow">

                <FrameLayout style="@style/AboutRowChip">
                    <ImageView
                        style="@style/AboutRowIcon"
                        android:src="@drawable/ic_email"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <LinearLayout style="@style/AboutRowText">
                    <TextView style="@style/AboutRowTitle" android:text="@string/about_contact_title" />
                    <TextView style="@style/AboutRowSubtitle" android:text="@string/about_contact_subtitle" />
                </LinearLayout>

                <ImageView style="@style/AboutRowChevron" app:tint="@color/colorGrayText" />
            </LinearLayout>

            <!-- Website -->
            <LinearLayout
                android:id="@+id/rowWebsite"
                style="@style/AboutRow">

                <FrameLayout style="@style/AboutRowChip">
                    <ImageView
                        style="@style/AboutRowIcon"
                        android:src="@drawable/ic_web"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <LinearLayout style="@style/AboutRowText">
                    <TextView style="@style/AboutRowTitle" android:text="@string/about_website_title" />
                    <TextView style="@style/AboutRowSubtitle" android:text="@string/about_website_subtitle" />
                </LinearLayout>

                <ImageView style="@style/AboutRowChevron" app:tint="@color/colorGrayText" />
            </LinearLayout>

            <!-- YouTube -->
            <LinearLayout
                android:id="@+id/rowYoutube"
                style="@style/AboutRow">

                <FrameLayout style="@style/AboutRowChip">
                    <ImageView
                        style="@style/AboutRowIcon"
                        android:src="@drawable/ic_youtube"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <LinearLayout style="@style/AboutRowText">
                    <TextView style="@style/AboutRowTitle" android:text="@string/about_youtube_title" />
                    <TextView style="@style/AboutRowSubtitle" android:text="@string/about_youtube_subtitle" />
                </LinearLayout>

                <ImageView style="@style/AboutRowChevron" app:tint="@color/colorGrayText" />
            </LinearLayout>

            <!-- Play Store -->
            <LinearLayout
                android:id="@+id/rowPlayStore"
                style="@style/AboutRow">

                <FrameLayout style="@style/AboutRowChip">
                    <ImageView
                        style="@style/AboutRowIcon"
                        android:src="@drawable/ic_playstore"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <LinearLayout style="@style/AboutRowText">
                    <TextView style="@style/AboutRowTitle" android:text="@string/about_playstore_title" />
                    <TextView style="@style/AboutRowSubtitle" android:text="@string/about_playstore_subtitle" />
                </LinearLayout>

                <ImageView style="@style/AboutRowChevron" app:tint="@color/colorGrayText" />
            </LinearLayout>

            <!-- Instagram -->
            <LinearLayout
                android:id="@+id/rowInstagram"
                style="@style/AboutRow">

                <FrameLayout style="@style/AboutRowChip">
                    <ImageView
                        style="@style/AboutRowIcon"
                        android:src="@drawable/ic_instagram"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <LinearLayout style="@style/AboutRowText">
                    <TextView style="@style/AboutRowTitle" android:text="@string/about_instagram_title" />
                    <TextView style="@style/AboutRowSubtitle" android:text="@string/about_instagram_subtitle" />
                </LinearLayout>

                <ImageView style="@style/AboutRowChevron" app:tint="@color/colorGrayText" />
            </LinearLayout>

            <!-- ============================ Footer ============================ -->
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_copyright"
                app:tint="@color/colorGrayText" />

            <TextView
                android:id="@+id/copyrightText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserrat"
                android:gravity="center"
                android:text="@string/about_made_with"
                android:textColor="@color/colorGrayText"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
