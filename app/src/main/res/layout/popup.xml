<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/background_popup"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="16dp"
        android:paddingBottom="26dp">

        <ImageButton
            android:id="@+id/closePopup"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_accent_button"
            android:padding="14dp"
            android:src="@drawable/ic_code"
            android:contentDescription="@string/Source_Code"
            app:tint="@color/keyAccentText" />

        <TextView
            android:id="@+id/heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/museo_bold"
            android:text="@string/popup_heading"
            android:textColor="@color/textColorPrimary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/popuptext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat"
            android:lineSpacingExtra="3dp"
            android:text="@string/popup_text"
            android:textAlignment="center"
            android:textColor="@color/colorGrayText"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/popupSourceBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_accent_button"
            android:fontFamily="@font/montserrat"
            android:stateListAnimator="@null"
            android:text="@string/Source_Code"
            android:textAllCaps="false"
            android:textColor="@color/keyAccentText"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
