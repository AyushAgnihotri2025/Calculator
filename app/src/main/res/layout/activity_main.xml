<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity"
    tools:openDrawer="start">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/context_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_body">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- ============================ Top bar ============================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/menuButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:theme="@style/Theme.AppCompat.DayNight"
                    app:contentInsetStart="0dp"
                    app:contentInsetStartWithNavigation="0dp" />

                <TextView
                    android:id="@+id/appInappName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/museo_bold"
                    android:letterSpacing="0.01"
                    android:text="@string/appInnappName"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="22sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/HistoryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_button"
                    android:fontFamily="@font/montserrat"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="History"
                    android:textAllCaps="false"
                    android:textColor="@color/keyFunctionText"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/daynight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:minHeight="44dp"
                    android:padding="0dp"
                    android:switchMinWidth="54dp"
                    android:thumb="@drawable/toggle_thumb"
                    android:track="@drawable/toggle_track"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </LinearLayout>

            <!-- ============================ LCD display ============================ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="17"
                android:background="@drawable/bg_display_panel"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Status strip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/DisplayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="fx-8BIT" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/DisplayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="DEG" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="11dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_solar_cell" />
                    </LinearLayout>

                    <!-- Digits -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/calculatorDisplayMock"
                            style="@style/DisplayText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/calculatorDisplayMock"
                            android:textColor="@color/displayMockFontColor" />

                        <TextView
                            android:id="@+id/calculatorDisplayMockCommas"
                            style="@style/DisplayText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text=""
                            android:textColor="@color/displayMockFontColor" />

                        <TextView
                            android:id="@+id/calculatorDisplayNonMock"
                            style="@style/DisplayText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:maxLength="12"
                            android:shadowColor="@color/displayGlow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="12"
                            android:textColor="@color/displayNonMockFontColor"
                            app:autoSizeMaxTextSize="44sp"
                            app:autoSizeMinTextSize="26sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ============================ Scientific panel ============================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="18"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/piButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="π" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/expButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="eˣ" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sqrt"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="√" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/powerButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="xʸ" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/factorialButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="n!" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/lnButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="ln" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/logButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="log" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sinButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="sin" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/cosButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="cos" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/tanButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="tan" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/permutationButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorPermutation" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/moduloButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="mod" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/inverseButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="1/x" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/percentButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorPercent" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================ Main keypad ============================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="66"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/acButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorAc"
                        android:textColor="@color/acBackspaceColor"
                        android:textSize="22sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/backspace"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="⌫"
                        android:textColor="@color/acBackspaceColor"
                        android:textSize="22sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/plusAndMinusButton"
                        style="@style/Key.Function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="±"
                        android:textSize="22sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/divideButton"
                        style="@style/Key.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorDivide" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sevenButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorSeven" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/eightButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorEight" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/nineButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorNine" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/multiplyButton"
                        style="@style/Key.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="×" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/fourButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorFour" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/fiveButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorFive" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sixButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorSix" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/minusButton"
                        style="@style/Key.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="−" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/oneButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorOne" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/twoButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorTwo" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/threeButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorThree" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/plusButton"
                        style="@style/Key.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorPlus" />
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/zeroButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="@string/calculatorZero" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/commaButton"
                        style="@style/Key.Number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorDot" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/equalsButton"
                        style="@style/Key.Accent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/calculatorEquals" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Kept so MainActivity can iterate the number keys via referencedIds. -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupOfNumbers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="zeroButton,oneButton,twoButton,threeButton,fourButton,fiveButton,sixButton,sevenButton,eightButton,nineButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:fitsSystemWindows="false"
        android:theme="@style/Theme.AppCompat.DayNight"
        app:elevation="12dp"
        app:headerLayout="@layout/menu_header"
        app:itemBackground="@drawable/nav_item_background"
        app:itemHorizontalPadding="18dp"
        app:itemIconPadding="18dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_icon"
        app:itemTextAppearance="@style/NavItemText"
        app:itemTextColor="@color/nav_item_text"
        app:menu="@menu/side_menu"
        app:subheaderColor="@color/colorAccent"
        app:subheaderTextAppearance="@style/NavSubheaderText" />

</androidx.drawerlayout.widget.DrawerLayout>
