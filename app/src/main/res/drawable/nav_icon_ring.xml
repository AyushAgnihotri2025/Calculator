<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded "squircle" badge that frames the app icon in the drawer header. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/keyNumberTop"
                android:endColor="@color/keyNumberBottom" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
</layer-list>
