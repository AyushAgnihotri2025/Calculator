<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated hero panel styled like the calculator's device body. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/bodyGradientTop"
        android:endColor="@color/bodyGradientBottom" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="@color/hairline" />
</shape>
