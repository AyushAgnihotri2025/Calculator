<?xml version="1.0" encoding="utf-8"?>
<!-- Light mode thumb: warm amber keycap with a dark sun glyph. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="28dp" android:height="28dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/keyAccentTop"
                android:endColor="@color/keyAccentBottom" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item
        android:width="15dp"
        android:height="15dp"
        android:gravity="center"
        android:drawable="@drawable/ic_sun" />
</layer-list>
