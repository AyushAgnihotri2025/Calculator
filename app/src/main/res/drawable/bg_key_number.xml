<?xml version="1.0" encoding="utf-8"?>
<!-- Sculpted number keycap: gradient face, rim highlight, drop shadow. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/keyRipple">
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/keyNumberShadow" />
                    <corners android:radius="19dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/keyNumberTop"
                        android:endColor="@color/keyNumberBottom" />
                    <corners android:radius="19dp" />
                    <stroke android:width="1dp" android:color="@color/keyHighlight" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</ripple>
