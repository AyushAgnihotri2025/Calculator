<?xml version="1.0" encoding="utf-8"?>
<!-- Compact pill used for the History button and dialog actions. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/keyRipple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/keyFunctionFace" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#1A000000" />
        </shape>
    </item>
</ripple>
